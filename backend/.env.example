# Configuracion del backend de Mantencion
# Copia este archivo como backend/.env y reemplaza los valores de ejemplo.
# Nunca subas backend/.env al repositorio.

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://maintenance_user:maintenance_pass@localhost:5433/maintenance_db

# Sesiones y tokens
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dominios autorizados para consumir la API. Debe ser un arreglo JSON.
CORS_ORIGINS=["http://localhost:3000"]

# Entorno: development o production
APP_ENV=development

# Google OAuth para escribir en Drive y Sheets (metodo recomendado)
# Se obtienen con: python scripts/google_oauth_setup.py
# Nunca subas estos valores al repositorio.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Cuenta de servicio de Google (alternativa, principalmente para lectura)
# Puedes indicar un archivo relativo a backend/ o el JSON directamente.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Hoja1

# Plantilla y carpeta raiz de las Ordenes de Trabajo
GOOGLE_OT_TEMPLATE_FILE_ID=
GOOGLE_OT_ROOT_FOLDER_ID=

# Registro mensual de OTs
# La plantilla y carpeta raiz permiten crear registros por ano.
GOOGLE_MONTHLY_TEMPLATE_FILE_ID=
GOOGLE_MONTHLY_ROOT_FOLDER_ID=
GOOGLE_MONTHLY_SPREADSHEET_ID=

# Firma de usuarios mediante Google Drive y Apps Script
GOOGLE_SIGNATURES_FOLDER_ID=
GOOGLE_SIGNATURES_APPS_SCRIPT_URL=
GOOGLE_SIGNATURES_APPS_SCRIPT_SECRET=

# Notificaciones push del navegador
# Se generan una sola vez para cada ambiente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administrador@ejemplo.cl
